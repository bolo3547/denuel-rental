# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/denuel_dev?schema=public"

# JWT
JWT_SECRET=change_this_to_a_strong_secret

# Map
NEXT_PUBLIC_MAPBOX_TOKEN=pk.sample_mapbox_token

# S3 / object storage (optional)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=your_region
S3_BUCKET=your_bucket
# optional public base url for uploaded objects (automatically generated if using S3)
NEXT_PUBLIC_S3_BASE_URL=https://your_bucket.s3.your_region.amazonaws.com

# SMTP (for saved-search notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# REDIS (optional for rate limiter and background jobs)
REDIS_URL=redis://:password@localhost:6379

# App
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Stripe / Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# SMS Notifications (Africa's Talking)
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_SHORTCODE=your_shortcode
SMS_FALLBACK_URL=https://your-sms-gateway.com/send

# Mobile Money - Airtel Money
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_API_URL=https://openapiuat.airtel.africa
AIRTEL_PIN=your_pin

# Mobile Money - MTN MoMo
MTN_SUBSCRIPTION_KEY=your_subscription_key
MTN_API_USER=your_api_user
MTN_API_KEY=your_api_key
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_CALLBACK_URL=https://yourdomain.com/api/webhook/mtn
MTN_ENVIRONMENT=sandbox

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# IoT Devices
IOT_WEBHOOK_SECRET=your_webhook_secret

# Firebase (Optional - for real-time features, cloud storage, FCM push notifications)
# Client SDK Configuration (public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (server-side - private keys)
# Option 1: Use service account JSON (recommended for production)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Option 2: Use individual credentials (easier for development)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
