# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/denuel_dev?schema=public"

# JWT
JWT_SECRET=change_this_to_a_strong_secret

# Map
NEXT_PUBLIC_MAPBOX_TOKEN=pk.sample_mapbox_token

# S3 / object storage (optional)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=your_region
S3_BUCKET=your_bucket
# optional public base url for uploaded objects (automatically generated if using S3)
NEXT_PUBLIC_S3_BASE_URL=https://your_bucket.s3.your_region.amazonaws.com

# SMTP (for saved-search notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# REDIS (optional for rate limiter and background jobs)
REDIS_URL=redis://:password@localhost:6379

# App
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Stripe / Payments (phase 2)
# STRIPE_SECRET=

# Firebase (client SDK — public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only — keep secret)
# Option 1: Base64-encoded service account JSON
# FIREBASE_SERVICE_ACCOUNT_KEY=
# Option 2: Individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
